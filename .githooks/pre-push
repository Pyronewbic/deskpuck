#!/bin/bash
# Scans the commits being pushed for secrets, then runs scripts/check.sh.
# Enable once per clone: git config core.hooksPath .githooks
set -uo pipefail

remote=$1
zero=0000000000000000000000000000000000000000

command -v gitleaks >/dev/null || { echo "CANNOT CHECK: gitleaks not found (brew install gitleaks)" >&2; exit 3; }

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    # A remote commit we do not have (new branch, or a force push) cannot bound
    # the range, so scan everything the remote has not seen.
    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range="$remote_sha..$local_sha"
    else
        range="$local_sha --not --remotes=$remote"
    fi
    # shellcheck disable=SC2086
    if ! count=$(git rev-list --count $range); then
        echo "CANNOT CHECK: could not list the commits for $local_ref" >&2
        exit 3
    fi
    [ "$count" -eq 0 ] && continue
    # gitleaks scans only commits with a text change (not merges, renames or binaries).
    # shellcheck disable=SC2086
    if ! patched=$(git log --no-merges -p -U0 --format='tformat:@C' $range |
        LC_ALL=C awk '$0 == "@C" { seen = 0; next } /^@@/ && !seen { n++; seen = 1 } END { print n + 0 }'); then
        echo "CANNOT CHECK: could not read the changes for $local_ref" >&2
        exit 3
    fi

    # gitleaks exits 0 when git itself fails, so its ERR lines count as failure too.
    # Leaks exit 2 so that 1 can only mean gitleaks failed.
    output=$(gitleaks git --no-banner --no-color --redact --exit-code 2 --log-opts="$range" . 2>&1)
    status=$?
    echo "$output" | grep -vE ' INF ' >&2
    if [ $status -eq 2 ]; then
        echo "Secrets found in commits for $remote_ref; push refused." >&2
        exit 1
    elif [ $status -ne 0 ] || grep -q ' ERR ' <<<"$output"; then
        echo "CANNOT CHECK: gitleaks failed on $local_ref (exit $status)" >&2
        exit 3
    elif ! grep -q " $patched commits scanned" <<<"$output"; then
        echo "CANNOT CHECK: gitleaks did not scan all $patched changed commits for $local_ref" >&2
        exit 3
    fi
done

exec "$(git rev-parse --show-toplevel)/scripts/check.sh"
