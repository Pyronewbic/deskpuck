#!/bin/bash
# Enable once per clone: git config core.hooksPath .githooks
set -uo pipefail

remote=$1
root=$(git rev-parse --show-toplevel) || exit 3
zero=0000000000000000000000000000000000000000

while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    # Unknown remote commit (new branch, force push): scan everything the remote lacks.
    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        "$root/scripts/scan-secrets.sh" "$remote_sha..$local_sha"
    else
        "$root/scripts/scan-secrets.sh" "$local_sha" --not "--remotes=$remote"
    fi
    status=$?
    if [ $status -eq 1 ]; then
        echo "Secrets found in commits for $remote_ref; push refused." >&2
    fi
    [ $status -eq 0 ] || exit $status
done

exec "$root/scripts/check.sh"
